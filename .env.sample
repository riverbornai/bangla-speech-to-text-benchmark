# Copy this file to .env and fill in the keys you have.
# .env is gitignored -- never commit real keys.
#
# Load it before running scripts, e.g.:
#   set -a; source .env; set +a
#   .venv/bin/python src/smoke_test.py

GROQ_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
SONIOX_API_KEY=
# Region-hosted Soniox API (defaults to the global endpoint if unset).
# EU example: https://api.eu.soniox.com/v1
SONIOX_API_BASE_URL=
GEMINI_API_KEY=

# Google Cloud STT v2 / Chirp 2
GOOGLE_CLOUD_PROJECT=
# Path to a Google Cloud service-account JSON. Use a dedicated account with
# only the Cloud Speech-to-Text role, keep the file outside this repo, and
# never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
